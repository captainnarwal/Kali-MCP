# Bind address for the MCP Streamable HTTP server
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Shared secret; client must send Authorization: Bearer <token>
# Leave empty to disable auth (not recommended on networks)
MCP_AUTH_TOKEN=change-me-to-a-long-random-secret

# Hostnames/IPs the MCP SDK should accept in the HTTP Host header.
# Required if you keep DNS-rebinding protection on and clients connect
# via a LAN/WSL IP instead of localhost. Comma-separated.
# Example: MCP_ALLOWED_HOSTS=172.23.133.230,kali.local
# Leave empty when MCP_HOST=0.0.0.0 to disable Host-header checks
# (Bearer auth still applies).
# MCP_ALLOWED_HOSTS=
# MCP_ALLOWED_ORIGINS=

# Allow the run_command tool (raw shell). Default false for safety.
ALLOW_RAW=false

# Default subprocess timeout in seconds for tool runs
DEFAULT_TIMEOUT=300

# Rotating file logs (also printed to stderr)
# Default dir: server/logs/server.log
# LOG_DIR=logs
LOG_LEVEL=INFO
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5

# Optional overrides for tool binary paths (defaults use PATH lookup)
# NMAP_PATH=nmap
# DIRB_PATH=dirb
# GOBUSTER_PATH=gobuster
# NIKTO_PATH=nikto
# ENUM4LINUX_PATH=enum4linux
# WPSCAN_PATH=wpscan
# SQLMAP_PATH=sqlmap
# HYDRA_PATH=hydra
# JOHN_PATH=john
# MSFCONSOLE_PATH=msfconsole
