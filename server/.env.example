# Bind address for the MCP Streamable HTTP server
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Shared secret; client must send Authorization: Bearer <token>
# Leave empty to disable auth (not recommended on networks)
MCP_AUTH_TOKEN=change-me-to-a-long-random-secret

# Allow the run_command tool (raw shell). Default false for safety.
ALLOW_RAW=false

# Default subprocess timeout in seconds for tool runs
DEFAULT_TIMEOUT=300

# Optional overrides for tool binary paths (defaults use PATH lookup)
# NMAP_PATH=nmap
# DIRB_PATH=dirb
# GOBUSTER_PATH=gobuster
# NIKTO_PATH=nikto
# ENUM4LINUX_PATH=enum4linux
# WPSCAN_PATH=wpscan
# SQLMAP_PATH=sqlmap
# HYDRA_PATH=hydra
# JOHN_PATH=john
# MSFCONSOLE_PATH=msfconsole
