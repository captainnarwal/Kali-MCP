# MCP server Streamable HTTP endpoint (include /mcp path)
# Local:  http://127.0.0.1:8000/mcp
# WSL/LAN example: http://172.23.133.230:8000/mcp
MCP_SERVER_URL=http://127.0.0.1:8000/mcp

# Must match the server's MCP_AUTH_TOKEN when auth is enabled
MCP_AUTH_TOKEN=change-me-to-a-long-random-secret

# LLM provider: anthropic | openai | gemini | mistral | ollama
LLM_PROVIDER=mistral

# Model name for the chosen provider
# anthropic: claude-sonnet-4-20250514
# openai: gpt-4o
# gemini: gemini-3.7-flash (or gemini-flash-latest)
# mistral: ministral-3b-latest (smallest) | mistral-small-latest | mistral-large-latest
# ollama: llama3.1
LLM_MODEL=ministral-3b-latest

# Provider API keys (set the one you use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
# GOOGLE_API_KEY=   # accepted as an alias for GEMINI_API_KEY

# Google Cloud project (Gemini / Vertex; optional)
GOOGLE_CLOUD_PROJECT=

# Ollama base URL (only needed for ollama provider)
OLLAMA_HOST=http://127.0.0.1:11434

# Max tool-calling rounds per user message
MAX_AGENT_TURNS=20

# Rotating file logs (also printed to stderr)
# Default dir: client/logs/client.log
# LOG_DIR=logs
LOG_LEVEL=INFO
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5
